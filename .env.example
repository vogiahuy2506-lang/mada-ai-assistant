# ===========================================
# MADA AI - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values

# ============== SERVER CONFIG ==============
PORT=3001
NODE_ENV=development

# ============== API KEYS ==============
# Gemini API Key - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============== VECTOR DATABASE PROVIDER ==============
# Chọn vector database provider:
#   milvus    - Milvus (local, cần Docker) [KHUYẾN NGHỊ]
#   pinecone  - Pinecone (cloud, cần API key)
#   mock      - Mock TF-IDF (demo, không cần gì)
# Để trống = auto-detect (thử Milvus → Pinecone → Mock)
VECTOR_DB_PROVIDER=milvus

# ============== MILVUS CONFIGURATION (Local) ==============
# CÀI ĐẶT DOCKER TRƯỚC: https://www.docker.com/products/docker-desktop/
# Sau đó chạy: npm run milvus:start
MILVUS_ADDRESS=localhost:19530
MILVUS_COLLECTION_NAME=mada_knowledge_base
MILVUS_AUTO_CREATE=true

# ============== PINECONE CONFIGURATION (Cloud) ==============
# Sign up at https://www.pinecone.io/ (Free tier: 100K vectors)
# Chỉ cần khi VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mada-knowledge-base
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# ============== AUTHENTICATION ==============
# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============== MAIL CONFIGURATION (Optional) ==============
# For consultation email notifications
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_TLS=false
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-email-password
# MAIL_FROM=mada.noreply@digiso.vn
# CONSULTATION_EMAIL=contact@mada.vn

# ============== DEVELOPMENT ==============
# Set to 'development' for local development
# Set to 'production' for production deployment
ENVIRONMENT=development

# ============== QUICK START COMMANDS ==============
# 1. Start Milvus: npm run milvus:start
# 2. Check status: npm run milvus:status
# 3. Migrate data: npm run milvus:migrate
# 4. Stop Milvus: npm run milvus:stop
