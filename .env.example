# ===========================================
# MADA AI - Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values

# ============== SERVER CONFIG ==============
PORT=3001
NODE_ENV=development

# ============== DEPLOY CONFIG ==============
# Docker image (used by docker-compose on VPS)
# Format: ghcr.io/<github-user>/<repo>:<tag>
MADA_IMAGE=ghcr.io/vohuy/mada-ai-assistant:latest

# ============== API KEYS ==============
# Gemini API Key - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============== VECTOR DATABASE PROVIDER ==============
# Vector database provider:
#   pinecone  - Pinecone (cloud, cần API key) [MẶC ĐỊNH]
# Khi PINECONE_API_KEY không hợp lệ / unset, hệ thống tự fallback về in-memory cosine search.
VECTOR_DB_PROVIDER=pinecone

# ============== PINECONE CONFIGURATION (Cloud) ==============
# Sign up at https://www.pinecone.io/ (Free tier: 100K vectors)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mada-knowledge-base
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# ============== AUTHENTICATION ==============
# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin user (auto-seeded on first run)
ADMIN_EMAIL=admin@mada.vn
ADMIN_PASSWORD=Admin@123

# ============== DATABASE ==============
DATABASE_PATH=/app/data/mada.db

# ============== MAIL CONFIGURATION (Optional) ==============
# For consultation email notifications (admin receives email when customer submits contact form)
# SMTP: mail.digiso.vn:465 (SSL) | Sender: mada.noreply@digiso.vn | Admin receiver: hotro.digibook@gmail.com
MAIL_HOST=mail.digiso.vn
MAIL_PORT=465
MAIL_SECURE=true
MAIL_TLS=true
MAIL_USERNAME=mada.noreply@digiso.vn
MAIL_PASSWORD=
MAIL_FROM=MADA AI <mada.noreply@digiso.vn>
CONSULTATION_EMAIL=hotro.digibook@gmail.com
ADMIN_URL=https://mada.digiso.vn

# ============== ENTRYPOINT ==============
# Set to true để tự chạy Pinecone migration khi container khởi động
RUN_PINEONE_MIGRATE=false

# ============== DEVELOPMENT ==============
# Set to 'development' for local development
# Set to 'production' for production deployment
ENVIRONMENT=development

# ============== QUICK START ==============
# Local dev:
#   1. Set PINECONE_API_KEY trong file .env
#   2. Chạy: npm run server (dev) hoặc docker-compose up -d (prod)
#   3. Migrate data: npm run pinecone:migrate
#
# VPS Deploy:
#   1. SSH vào VPS, chạy: bash scripts/setup-vps.sh
#   2. Copy docker-compose.yml và nginx/nginx.conf lên VPS
#   3. Push code lên GitHub - CI/CD sẽ tự động deploy
