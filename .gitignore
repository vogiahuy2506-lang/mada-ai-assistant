# Data (keep structure but ignore content)
data/
!data/.gitkeep
!data/chroma/.gitkeep

# BUT allow backend source data (seed data, fixtures, configs)
!backend/src/data/
!backend/data/
!server/lib/data/

# Ignore runtime data in backend/data/ but keep the folder structure
backend/data/products/
backend/data/embeddings/
backend/data/standards/

# Vector database files
data/chroma/*
data/ingestion_log.json
*.db
*.sqlite

# Docker
.dockerignore

# Git
.git/
!.gitignore
.gitattributes

# CI/CD - allow workflow files
# (removed .github/ rule so workflow files can be committed)

# Documentation
docs/_build/
site/

# Misc
*.tgz
*.tar.gz

# Tesseract trained data (large binary files)
*.traineddata

