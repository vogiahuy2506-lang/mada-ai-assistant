# ============================================
# MADA AI Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============================================
# GEMINI AI CONFIGURATION (Required)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=8192

# ============================================
# PINECONE VECTOR DATABASE (Optional - for production)
# ============================================
# Get your API key from: https://www.pinecone.io/
# Leave empty to use in-memory store (development mode)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mada-products
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Enable Pinecone (set to 'true' for production)
ENABLE_PINECONE=false

# ============================================
# EMBEDDINGS CONFIGURATION
# ============================================
# Set to 'true' for production (requires valid GEMINI_API_KEY)
USE_REAL_EMBEDDINGS=false
EMBEDDING_MODEL=gemini-embedding-exp-03-07
EMBEDDING_DIMENSION=768

# ============================================
# REDIS (Optional - for session management)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_TTL=86400
SESSION_SECRET=change-this-in-production-use-a-secure-random-string

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_RAG=true
ENABLE_GUARDRAILS=true
ENABLE_METRICS=true
