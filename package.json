{
  "name": "mada-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --resolve-extensions=.ts,.js --external:sharp --external:better-sqlite3 --external:@google/generative-ai --external:@pinecone-database/pinecone --external:pdf-parse --external:mammoth --external:bcryptjs --external:express --external:express-session --external:passport --external:passport-google-oauth20 --external:stripe --external:nodemailer --external:multer --external:jsonwebtoken --external:cors --external:dotenv --external:node-cron --external:tesseract.js --external:cheerio --external:uuid --external:xlsx --external:zod --minify --sourcemap",
    "build:client": "vite build",
    "build:full": "npm run build:server && tsc -b && vite build",
    "build:analyze": "vite build --mode analyze && npx vite-bundle-visualizer",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "start": "node dist/server.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:install": "npx playwright install --with-deps",
    "test:performance": "npx tsx server/tests/performance-test.ts",
    "test:performance:benchmark": "npx tsx server/tests/performance-test.ts --benchmark 10",
    "test:qa": "npx tsx server/tests/run-tests.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 1000",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "pinecone:migrate": "npx tsx server/scripts/migrate-to-pinecone.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@pinecone-database/pinecone": "^8.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^22.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
