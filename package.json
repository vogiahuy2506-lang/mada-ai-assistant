{
  "name": "mada-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "milvus:start": "mkdir -p volumes/milvus volumes/etcd volumes/minio && docker run -d --name milvus-etcd -p 2379:2379 -v $(pwd)/volumes/etcd:/etcd milvusdb/etcd:latest etcd -advertise-client-urls=http://127.0.0.1:2379 etcd -listen-client-urls=http://0.0.0.0:2379 --data-dir=/etcd && docker run -d --name milvus-minio -p 9001:9001 -p 9091:9091 -v $(pwd)/volumes/minio:/minio_data minio/minio:latest server /minio_data --console-address \":9091\" -address \":9001\" && docker run -d --name milvus-standalone -p 19530:19530 -p 9091:9091 -v $(pwd)/volumes/milvus:/var/lib/milvus milvusdb/milvus:latest milvus run standalone",
    "milvus:stop": "docker stop milvus-standalone milvus-minio milvus-etcd",
    "milvus:remove": "docker rm -f milvus-standalone milvus-minio milvus-etcd",
    "milvus:status": "docker ps --filter \"name=milvus\" --filter \"name=minio\"",
    "milvus:logs": "docker logs milvus-standalone --tail 50",
    "milvus:migrate": "npx tsx server/scripts/migrate-to-milvus.ts",
    "milvus:health": "curl -s http://localhost:19530/healthz || echo 'Milvus not running'",
    "pinecone:migrate": "npx tsx server/scripts/migrate-to-pinecone.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@pinecone-database/pinecone": "^8.2.0",
    "@types/nodemailer": "^8.0.1",
    "@zilliz/milvus2-sdk-node": "^3.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
